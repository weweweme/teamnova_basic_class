# 기기마다 다른 값 — 이 파일을 .env 로 복사해서 자기 PC에 맞게 고친다.
#   맥/리눅스 : cp .env.example .env
#   윈도우    : copy .env.example .env
#
# .env 는 Git에 올리지 않는다(.gitignore). 기기별 사정을 담는 파일이라
# 공유하면 서로의 설정을 덮어쓰게 된다. 이 예시 파일만 Git으로 공유한다.

# ── Apache+PHP+MariaDB 가 설치된 로컬 이미지 이름 ──────────────
#   손으로 설치한 상태를 저장해 둔 이미지라 Docker Hub에서 받을 수 없다.
#   `docker images` 로 확인해서 자기 PC에 있는 이름을 적는다.
LAMP_IMAGE=my_lamp_backup

# ── 내 PC에서 쓸 포트 번호 ────────────────────────────────────
#   컨테이너 안은 항상 80/3306 이고, 여기 값은 '내 PC의 어느 번호로 들어갈지'만 정한다.
#   그래서 이 값을 바꿔도 소스코드는 고칠 필요가 없다.
#   ※ 이미 다른 프로그램이 쓰는 번호면 컨테이너가 안 뜬다 → 다른 번호로 바꾼다.
#     (맥 8080 / 윈도우 8081 을 쓰는 중)
WEB_PORT=8080
DB_PORT=3306
